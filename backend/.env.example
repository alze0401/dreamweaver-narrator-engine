# ============================================
# 织梦绮谭 - 环境变量配置 (示例)
# 复制此文件为 .env 并填入你的实际配置
# ============================================

# ---- DeepSeek API 配置 ----
# 从 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 应用配置 ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ---- MySQL 数据库 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=narrator
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=narrator_engine

# ---- Redis 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-password-here
REDIS_DB=0

# ---- ChromaDB（向量记忆库）----
CHROMA_PERSIST_DIR=./data/chroma

# ---- LLM 生成参数 ----
LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9

# ---- 记忆系统参数 ----
MEMORY_MAX_WORKING_TURNS=12
MEMORY_MAX_EPISODIC_SUMMARIES=30
MEMORY_MIN_IMPORTANCE=6
MEMORY_VECTOR_SEARCH_TOP_K=8

# ---- Redis 缓存 TTL（秒）----
CACHE_TTL_GAME_SESSION=3600
CACHE_TTL_TEMPLATE=1800
CACHE_TTL_DIALOGUE=300
