# ============================================
# 织梦绮谭 - Git Ignore 规则
# ============================================

# ---- 环境 / 密钥 ----
.env
.env.local
.env.production

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so
.Python
pip-log.txt

# ---- 数据文件 ----
backend/data/
backend/app/data/
backend/nul
*.db
*.sqlite3
saves/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- 大型文件 / 非代码 ----
*.pptx
*.ppt
*.zip
*.rar
*.mp3
*.onnx
*.tar.gz
chroma_model/
backend/.env.prod
backend/debug_check.py

# ---- 日志 ----
*.log
logs/
