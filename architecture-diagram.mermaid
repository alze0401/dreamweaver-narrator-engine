    style Pages fill:#312e81,stroke:#6366f1,color:#c7d2fe
    style Components fill:#312e81,stroke:#6366f1,color:#c7d2fe
    style StateMgmt fill:#312e81,stroke:#818cf8,color:#c7d2fe
    style Backend fill:#0c1222,stroke:#38bdf8,color:#e0f2fe
    style API fill:#164e63,stroke:#22d3ee,color:#cffafe
    style Engine fill:#1e293b,stroke:#f59e0b,color:#fef3c7
    style LangGraph fill:#78350f,stroke:#fbbf24,color:#fef9c3
    style LLM fill:#3b0764,stroke:#c084fc,color:#f3e8ff
    style Infra fill:#1c1917,stroke:#a8a29e,color:#e7e5e4
    style DataLayer fill:#14532d,stroke:#4ade80,color:#dcfce7
    style MemoryArch fill:#4c1d95,stroke:#a78bfa,color:#ede9fe
    style Models fill:#14532d,stroke:#86efac,color:#dcfce7
    style External fill:#7f1d1d,stroke:#f87171,color:#fecaca
